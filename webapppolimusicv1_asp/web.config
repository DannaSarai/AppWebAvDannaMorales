<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.asp" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- Los includes (credenciales y lógica) no se pueden pedir directamente -->
        <hiddenSegments>
          <remove segment="includes" />
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
